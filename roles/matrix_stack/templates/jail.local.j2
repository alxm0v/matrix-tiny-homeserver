[DEFAULT]
# Basic Ban Settings
bantime = 1h
findtime = 10m
maxretry = 5

# Incremental Ban Logic
# If a user is banned multiple times, their ban time increases.
bantime.increment = true
bantime.rndtime = 30m
bantime.maxtime = 24h
bantime.factor = 1

[sshd]
enabled = true
port = ssh
filter = sshd
logpath = /var/log/auth.log
# Use systemd backend for newer distributions
backend = systemd
